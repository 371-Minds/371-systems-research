    `;

    const token = getAccessToken();
    const contentBody = document.getElementById("content-body");
    const extractBtn = document.getElementById("extract-ontology-btn");
    const ontologyBox = document.getElementById("ontology-output-box");

    let extractedText = "";

    if (token && contentBody) {
      try {
        extractedText = await fetchFileContentPreview(token, file.id, file.mimeType);
        contentBody.textContent = extractedText;
      } catch (e: any) {
        contentBody.textContent = `Could not extract text stream: ${e.message}`;
