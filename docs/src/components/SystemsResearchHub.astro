  // Federated Multi-Drive Ingestion
  async function loadFederatedDriveData() {
    const accounts = getAllAccounts();
    if (accounts.length === 0) return;

    if (driveLoading) driveLoading.style.display = "flex";
    if (driveEmptyUnauth) driveEmptyUnauth.style.display = "none";
    if (driveEmptySearch) driveEmptySearch.style.display = "none";
    if (driveFilesList) driveFilesList.style.display = "none";

    try {
      const filterVal = (typeFilter?.value as any) || "all";
      const queryVal = searchInput?.value || "";
      const selectedScope = driveAccountSelector?.value || "all";

      let targetAccounts = accounts;
      if (selectedScope !== "all") {
        targetAccounts = accounts.filter((a) => a.id === selectedScope);
      }

      // Query all target drives in parallel
      const filePromises = targetAccounts.map(async (acc) => {
        try {
          const res = await listDriveFiles(
            acc.accessToken,
            { query: queryVal, mimeTypeFilter: filterVal },
            { email: acc.email, label: acc.label || acc.displayName }
          );
          // Register files directly into the Model Context Protocol (MCP) registry!
          mcpRegistry.syncDriveFilesToMcp(res.files, acc.label || acc.displayName, acc.id);
          return res.files;
        } catch (err) {
          console.error(`Error querying drive for ${acc.email}:`, err);
          return [];
        }
      });

      const results = await Promise.all(filePromises);
      currentFiles = results.flat();

      if (mcpDriveResourcesCount) {
        mcpDriveResourcesCount.textContent = `${currentFiles.length} synced to MCP`;
      }

      renderFiles(currentFiles);
    } catch (err: any) {
      console.error("Failed to list Google Drive files:", err);
      if (driveFilesList) {
        driveFilesList.innerHTML = `<li class="error-item">⚠️ Unable to load Google Drive files: ${err.message}</li>`;
        driveFilesList.style.display = "block";
      }
    } finally {
      if (driveLoading) driveLoading.style.display = "none";
    }
  }

