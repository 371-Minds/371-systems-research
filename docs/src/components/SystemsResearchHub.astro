---
// Systems Scientist Research Hub Component with Multi-Drive & MCP Integration
---

<div id="systems-research-hub" class="systems-hub-wrapper">
  <!-- Top Metasystemic Banner & Status -->
  <div class="hub-header-card">
    <div class="hub-badge-row">
      <span class="hub-chip pulse">Metasystemic Architecture</span>
      <span class="hub-chip">Systems Scientist Research Hub</span>
      <span id="auth-status-chip" class="hub-chip status-idle">0 Drives Connected</span>
      <span class="hub-chip accent-chip">Model Context Protocol (MCP) Enabled</span>
      <span class="hub-chip non-tech-chip">Zero-Friction Non-Tech Engine</span>
    </div>
    <h2 class="hub-main-title">Systems Scientist Research Hub & Model Context Protocol Gateway</h2>
    <p class="hub-subtitle">
      Seamlessly federate across <strong>multiple Google Drive accounts</strong> (Personal, Laboratory, Enterprise) and external tools via the <strong>Model Context Protocol (MCP)</strong>. Ingest literature, datasets, and system ontology models into cybernetic causal feedback simulations and 1-click frictionless deployment packages.
    </p>

    <!-- Multi-Account Drive Bar -->
    <div id="auth-section" class="hub-auth-bar">
      <!-- Accounts Manager Strip -->
      <div class="multi-drive-control-bar">
        <div class="accounts-header">
          <div class="accounts-label-group">
            <span class="drive-icon-badge">📁</span>
            <div>
              <strong class="accounts-title">Connected Google Drive Repositories</strong>
              <div class="accounts-sub">Federate multiple personal, lab, or organizational Google Drives simultaneously</div>
            </div>
          </div>
          <button id="add-google-drive-btn" type="button" class="hub-btn hub-btn-primary add-drive-btn">
            <span>+ Connect Another Google Drive</span>
          </button>
        </div>

        <!-- Dynamic List of Connected Drive Accounts -->
        <div id="accounts-chip-list" class="accounts-pills-row">
          <div class="empty-accounts-prompt">
            No Google Drives connected yet. Click <strong>Connect Google Drive</strong> to authenticate the first repository with secure client-side in-memory tokens.
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Systems Scientist Workbenches -->
  <div class="hub-grid">
    <!-- Left Column: Multi-Drive Ingestion & Unified Knowledge Graph Pipeline -->
    <div class="hub-panel">
      <div class="panel-header">
        <div class="panel-title-group">
          <span class="panel-icon">📂</span>
          <h3>Federated Ingestion Stream</h3>
        </div>
        <div class="panel-actions-group">
          <select id="drive-account-selector" class="hub-select-account">
            <option value="all">All Connected Drives</option>
          </select>
          <span id="files-count-badge" class="counter-badge">0 items</span>
        </div>
      </div>

      <div class="search-filter-bar">
        <input
          id="drive-search-input"
          type="text"
          placeholder="Search across all connected Google Drives..."
          class="hub-input"
        />
        <select id="drive-type-filter" class="hub-select">
          <option value="all">All Types</option>
          <option value="documents">Docs & Text</option>
          <option value="pdfs">PDFs</option>
          <option value="spreadsheets">Sheets</option>
          <option value="code">Code / Schemas</option>
        </select>
      </div>

      <div id="drive-loading-state" class="hub-state-box" style="display: none;">
        <div class="spinner"></div>
        <p>Querying Google Drive files across connected accounts...</p>
      </div>

      <div id="drive-empty-unauth" class="hub-state-box">
        <div class="empty-icon">🔒</div>
        <h4>Drive Storage Standby</h4>
        <p>Connect one or more Google Drives above to securely stream research files into this Metasystemic session.</p>
        <div class="offline-presets-box">
          <span class="preset-label">Or test with research archetypes:</span>
          <div class="preset-btns-row">
            <button class="hub-btn hub-btn-sm hub-btn-subtle test-archetype-btn" data-archetype="cybernetics">
              Cybernetics (VSM)
            </button>
            <button class="hub-btn hub-btn-sm hub-btn-subtle test-archetype-btn" data-archetype="leverage">
              12 Leverage Points
            </button>
            <button class="hub-btn hub-btn-sm hub-btn-subtle test-archetype-btn" data-archetype="electrobun">
              Electrobun Architecture
            </button>
          </div>
        </div>
      </div>

      <div id="drive-empty-search" class="hub-state-box" style="display: none;">
        <div class="empty-icon">🔍</div>
        <h4>No matching files found</h4>
        <p>Try searching with another keyword or adjust your category filter.</p>
      </div>

      <ul id="drive-files-list" class="files-list" style="display: none;">
        <!-- Dynamically injected items -->
      </ul>
    </div>

    <!-- Right Column: Metasystemic Synthesis & System Dynamics Modeler -->
    <div class="hub-panel synthesis-panel">
      <div class="panel-header">
        <div class="panel-title-group">
          <span class="panel-icon">⚡</span>
          <h3>Metasystemic Synthesis & Simulation Engine</h3>
        </div>
        <div class="tab-group">
          <button id="tab-modeler" class="tab-btn active" type="button">Systems Modeler</button>
          <button id="tab-simulator" class="tab-btn" type="button">Causal Canvas & Sim</button>
          <button id="tab-mcp" class="tab-btn" type="button">MCP Ecosystem</button>
          <button id="tab-preview" class="tab-btn" type="button">Doc Inspector</button>
          <button id="tab-frictionless" class="tab-btn" type="button">Zero-Friction Deploy</button>
        </div>
      </div>

      <!-- Tab 1: Systems Modeler & Feedback Analyzer -->
      <div id="view-modeler" class="tab-view active">
        <div class="modeler-intro">
          <h4>Active Metasystem Dynamics & Multi-Source Feedback</h4>
          <p>
            Synthesizes inputs across federated Google Drives and MCP contextual servers into self-regulating feedback loops, variety attenuation, and zero-friction adoption pipelines.
          </p>
        </div>

        <div class="system-loops-grid">
          <div class="loop-card balancing">
            <div class="loop-head">
              <span class="loop-tag">Balancing Loop (B1)</span>
              <span class="loop-status">Equilibrium</span>
            </div>
            <h5>Cognitive Friction vs Non-Tech Adoption</h5>
            <p>
              As interface abstraction increases, cognitive overload drops exponentially, accelerating enterprise and citizen adoption of complex system backends.
            </p>
            <div class="loop-metrics">
              <span>Goal: Zero CLI barrier</span>
              <span>Damping: 0.15s</span>
            </div>
          </div>

          <div class="loop-card reinforcing">
            <div class="loop-head">
              <span class="loop-tag">Reinforcing Loop (R1)</span>
              <span class="loop-status">Compounding</span>
            </div>
            <h5>Multi-Drive Knowledge Synergy & MCP Graph</h5>
            <p>
              Federating across multiple research drives compounds cross-domain ontological connections, improving automatic systems architectural heuristics.
            </p>
            <div class="loop-metrics">
              <span>Multi-Source Synergy: 2.45x</span>
              <span>Entropy reduction: 82%</span>
            </div>
          </div>
        </div>

        <!-- Interactive Synthesizer Sandbox -->
        <div class="synthesizer-card">
          <h4>Metasystemic Linkage Integrator</h4>
          <p class="desc">
            Provide any document from your connected Google Drives, arXiv paper, GitHub repository link, or ontology schema to generate a zero-friction deployment blueprint for non-technical stakeholders.
          </p>
          <div class="link-presets-row">
            <span class="preset-label">Quick Links:</span>
            <button class="preset-pill" data-link="https://github.com/blackboardsh/electrobun">Electrobun Runtime Repo</button>
            <button class="preset-pill" data-link="https://framework.blackboard.sh/electrobun/guides/architecture/overview/">Cybernetic Architecture Spec</button>
            <button class="preset-pill" data-link="https://modelcontextprotocol.io">Model Context Protocol (MCP) Spec</button>
            <button class="preset-pill" data-link="https://arxiv.org/abs/complex-adaptive-systems-vsm">VSM Systems Paper</button>
          </div>
          <div class="link-input-row">
            <input
              id="metasystem-link-input"
              type="text"
              placeholder="e.g. Google Drive Document, ArXiv URL, Github repo link, or ontology schema..."
              class="hub-input"
            />
            <button id="synthesize-btn" class="hub-btn hub-btn-primary" type="button">
              Synthesize Blueprint
            </button>
          </div>
          <div id="synthesizer-output" class="synthesizer-results">
            <div class="blueprint-card">
              <div class="bp-header">
                <span class="bp-title">Frictionless Adoption Blueprint: Multi-Source Model</span>
                <span class="bp-badge">Ready for Non-Techs</span>
              </div>
              <div class="bp-steps">
                <div class="bp-step">
                  <div class="step-num">1</div>
                  <div>
                    <strong>Federated Identity & Multi-Drive Ingestion:</strong>
                    Direct client-side OAuth with zero credential leakage, allowing non-tech users to connect multiple team or personal drives effortlessly.
                  </div>
                </div>
                <div class="bp-step">
                  <div class="step-num">2</div>
                  <div>
                    <strong>Standardized MCP Context Server:</strong>
                    Exposes Drive documents, GitHub repositories, and open preprints under universal JSON-RPC 2.0 endpoints for instant agentic access.
                  </div>
                </div>
                <div class="bp-step">
                  <div class="step-num">3</div>
                  <div>
                    <strong>Autonomous 1-Click Desktop / Web Run:</strong>
                    Powered by Electrobun's ultra-lightweight Cottontail runtime or instant web preview; no 300MB Chromium installs.
                  </div>
                </div>
              </div>
              <div class="bp-actions">
                <button class="hub-btn hub-btn-sm hub-btn-outline export-bundle-btn" type="button">
                  📦 Export 1-Click HTML Bundle
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: Causal Loop Canvas & Real-Time Simulator -->
      <div id="view-simulator" class="tab-view" style="display: none;">
        <div class="simulator-wrapper">
          <div class="sim-header">
            <div>
              <h4>Cybernetic Causal Loop Visualizer & Simulator</h4>
              <p class="sim-desc">
                Interactive dynamics showing information flow across federated drives, variety attenuation, and non-technical adoption equilibrium.
              </p>
            </div>
            <div class="sim-controls">
              <button id="sim-play-pause-btn" class="hub-btn hub-btn-sm hub-btn-primary" type="button">▶ Run Simulation</button>
              <button id="sim-reset-btn" class="hub-btn hub-btn-sm hub-btn-subtle" type="button">↺ Reset</button>
            </div>
          </div>

          <!-- Dynamic Causal Canvas -->
          <div class="canvas-container">
            <canvas id="causal-loop-canvas" width="600" height="260"></canvas>
            <div class="canvas-legend">
              <span class="legend-item"><span class="legend-dot green"></span> (+) Reinforcing Flow</span>
              <span class="legend-item"><span class="legend-dot blue"></span> (-) Balancing Feedback</span>
              <span class="legend-item"><span class="legend-dot gold"></span> Information Particle</span>
            </div>
          </div>

          <!-- Simulation Parameter Sliders -->
          <div class="sim-params-grid">
            <div class="param-slider-card">
              <div class="param-head">
                <label for="slider-abstraction">UI Abstraction (Zero-CLI)</label>
                <span id="val-abstraction" class="slider-val">85%</span>
              </div>
              <input id="slider-abstraction" type="range" min="10" max="100" value="85" class="hub-range" />
            </div>

            <div class="param-slider-card">
              <div class="param-head">
                <label for="slider-velocity">Feedback Velocity</label>
                <span id="val-velocity" class="slider-val">1.4x</span>
              </div>
              <input id="slider-velocity" type="range" min="0.2" max="3.0" step="0.1" value="1.4" class="hub-range" />
            </div>

            <div class="param-slider-card">
              <div class="param-head">
                <label for="slider-friction">Friction Damping</label>
                <span id="val-friction" class="slider-val">70%</span>
              </div>
              <input id="slider-friction" type="range" min="10" max="100" value="70" class="hub-range" />
            </div>
          </div>

          <!-- Live Metrics Chart Canvas -->
          <div class="metrics-chart-box">
            <div class="chart-header">
              <span>Dynamic State Variables: Adoption (Green), Systemic Coherence (Blue), Friction (Red)</span>
              <span id="sim-step-counter" class="chart-step">T = 0s</span>
            </div>
            <canvas id="metrics-plot-canvas" width="600" height="120"></canvas>
          </div>
        </div>
      </div>

      <!-- Tab 3: Model Context Protocol (MCP) Ecosystem & Extension Hub -->
      <div id="view-mcp" class="tab-view" style="display: none;">
        <div class="mcp-ecosystem-wrapper">
          <div class="mcp-intro-banner">
            <div class="mcp-intro-title">
              <span class="mcp-icon">🌐</span>
              <h4>Model Context Protocol (MCP) Metasystem Gateway</h4>
            </div>
            <p>
              <strong>Yes!</strong> The Model Context Protocol (MCP) is the ideal open standard for this metasystemic hub. Instead of building bespoke one-off integrations for every cloud drive or database, MCP establishes a universal client-server specification (JSON-RPC) allowing models and non-technical apps to access:
            </p>
            <ul class="mcp-feature-list">
              <li><strong>Unified Resource URIs:</strong> e.g., <code>mcp://google-drive/&lt;account&gt;/&lt;fileId&gt;</code>, <code>mcp://github/repo/commit</code>, <code>mcp://arxiv/paper</code></li>
              <li><strong>Agentic Tool Execution:</strong> <code>package_frictionless_bundle</code>, <code>query_systems_papers</code>, <code>extract_feedback_loops</code></li>
              <li><strong>Dynamic Prompts & Context Templates:</strong> Cybernetic variety attenuation, Ashby's Law balance, Meadows leverage point synthesis</li>
            </ul>
          </div>

          <!-- Active MCP Servers Matrix -->
          <div class="mcp-servers-grid">
            <div class="mcp-server-card active">
              <div class="mcp-card-header">
                <span class="mcp-server-icon">📁</span>
                <div class="mcp-server-meta">
                  <h5>Google Drive MCP Gateway</h5>
                  <span class="mcp-status-pill connected">Connected (Federated)</span>
                </div>
              </div>
              <p class="mcp-card-desc">Provides normalized MCP resources and live document streams across all authenticated Google Drive accounts.</p>
              <div class="mcp-metrics-row">
                <span><strong>Resources:</strong> <span id="mcp-drive-resources-count">0 synced</span></span>
                <span><strong>Tools:</strong> 3 active</span>
                <span><strong>Protocol:</strong> JSON-RPC 2.0</span>
              </div>
              <div class="mcp-tools-list">
                <code>drive_read_resource(uri)</code>
                <code>drive_search_files(query)</code>
              </div>
            </div>

            <div class="mcp-server-card active">
              <div class="mcp-card-header">
                <span class="mcp-server-icon">⚡</span>
                <div class="mcp-server-meta">
                  <h5>Electrobun Desktop Host MCP</h5>
                  <span class="mcp-status-pill connected">Connected</span>
                </div>
              </div>
              <p class="mcp-card-desc">Direct RPC bridge for native windowing, Cottontail micro-runtime bundles, and zero-CLI desktop packaging.</p>
              <div class="mcp-metrics-row">
                <span><strong>Resources:</strong> 14 schemas</span>
                <span><strong>Tools:</strong> 8 active</span>
                <span><strong>Target:</strong> Cross-Platform</span>
              </div>
              <div class="mcp-tools-list">
                <code>package_frictionless_bundle(target)</code>
                <code>create_native_window(config)</code>
              </div>
            </div>

            <div class="mcp-server-card active">
              <div class="mcp-card-header">
                <span class="mcp-server-icon">📚</span>
                <div class="mcp-server-meta">
                  <h5>ArXiv Systems Science MCP</h5>
                  <span class="mcp-status-pill connected">Active</span>
                </div>
              </div>
              <p class="mcp-card-desc">Semantic search across open-access preprints, cybernetic feedback papers, and complex adaptive systems models.</p>
              <div class="mcp-metrics-row">
                <span><strong>Resources:</strong> 3,500+ papers</span>
                <span><strong>Tools:</strong> 2 active</span>
                <span><strong>Feed:</strong> cs.SY / nlin.AO</span>
              </div>
              <div class="mcp-tools-list">
                <code>query_systems_papers(topic)</code>
              </div>
            </div>

            <div class="mcp-server-card active">
              <div class="mcp-card-header">
                <span class="mcp-server-icon">🐙</span>
                <div class="mcp-server-meta">
                  <h5>GitHub Metasystem Bridge</h5>
                  <span class="mcp-status-pill connected">Ready</span>
                </div>
              </div>
              <p class="mcp-card-desc">Repository sync, commit logs, release artifacts, and automated workflow triggers for 371-Minds and blackboardsh/electrobun.</p>
              <div class="mcp-metrics-row">
                <span><strong>Resources:</strong> 24 repositories</span>
                <span><strong>Tools:</strong> 4 active</span>
                <span><strong>Branch:</strong> main / dev</span>
              </div>
              <div class="mcp-tools-list">
                <code>fetch_repo_manifest(owner, repo)</code>
              </div>
            </div>
          </div>

          <!-- Add Custom MCP Server Connector -->
          <div class="add-mcp-box">
            <h5>+ Connect Additional Custom MCP Context Server</h5>
            <p>Enter any external Model Context Protocol server endpoint (HTTP SSE or WebSocket) to federate Notion, Obsidian, Postgres, Slack, or custom research databases:</p>
            <div class="add-mcp-row">
              <input id="custom-mcp-url" type="text" placeholder="https://mcp.your-lab.domain/sse or sse://localhost:8080" class="hub-input" />
              <button id="add-custom-mcp-btn" class="hub-btn hub-btn-primary" type="button">Connect Server</button>
            </div>
            <div id="mcp-connect-toast" class="mcp-toast" style="display: none;"></div>
          </div>
        </div>
      </div>

      <!-- Tab 4: Document Inspector -->
      <div id="view-preview" class="tab-view" style="display: none;">
        <div id="doc-preview-container" class="preview-box">
          <div class="preview-empty">
            <span class="preview-icon">📄</span>
            <h4>Select a Document to Inspect</h4>
            <p>Click "Inspect" on any document in your Google Drive list to load full preview and systemic extracted concepts.</p>
          </div>
        </div>
      </div>

      <!-- Tab 5: Zero-Friction Deploy Architect -->
      <div id="view-frictionless" class="tab-view" style="display: none;">
        <div class="zero-friction-panel">
          <div class="panel-head-group">
            <h4>Frictionless Metasystemic Deployment Protocol</h4>
            <button id="download-full-manifest-btn" class="hub-btn hub-btn-sm hub-btn-primary" type="button">
              💾 Download Deployment Manifest (.json)
            </button>
          </div>
          <p>
            Standardized operational parameters configured to guarantee 100% non-technical usability across organizations:
          </p>

          <div class="protocol-matrix">
            <div class="proto-item">
              <div class="proto-icon">🎯</div>
              <div>
                <strong>Single Action Launch</strong>
                <p>Applications start without runtime dependencies, Python environments, or CLI prompts. Click to open in browser or standalone lightweight desktop window.</p>
              </div>
            </div>
            <div class="proto-item">
              <div class="proto-icon">🔐</div>
              <div>
                <strong>Ephemeral In-Memory Tokens</strong>
                <p>Strict security standard preventing unencrypted local storage persistence while preserving session fluidity across all connected Google Drives.</p>
              </div>
            </div>
            <div class="proto-item">
              <div class="proto-icon">🌐</div>
              <div>
                <strong>Universal Cross-Platform Target</strong>
                <p>Consistent behavior across Web, macOS, Linux, and Windows via native system views and Electrobun's Cottontail runtime.</p>
              </div>
            </div>
            <div class="proto-item">
              <div class="proto-icon">🧠</div>
              <div>
                <strong>Self-Describing Data Schema (MCP)</strong>
                <p>Translates complex multi-source APIs into clean visual action cards, metrics, and forms that require no code comprehension.</p>
              </div>
            </div>
          </div>

          <!-- Stafford Beer Viable System Model (VSM) Architecture Matrix -->
          <div class="vsm-matrix-card">
            <h5>Viable System Model (VSM) Cybernetic Layers</h5>
            <div class="vsm-grid">
              <div class="vsm-col">
                <span class="vsm-badge">System 1</span>
                <strong>Operations</strong>
                <p>Federated Google Drive read-only retrieval, document parsing, Electrobun runtime views.</p>
              </div>
              <div class="vsm-col">
                <span class="vsm-badge">System 2</span>
                <strong>Coordination</strong>
                <p>MCP JSON-RPC router, debounced multi-account search, token lifecycle synchronization.</p>
              </div>
              <div class="vsm-col">
                <span class="vsm-badge">System 3</span>
                <strong>Operational Control</strong>
                <p>Dynamic feedback loop simulation, balance balancing loop (B1), variety attenuation audit.</p>
              </div>
              <div class="vsm-col">
                <span class="vsm-badge">System 4</span>
                <strong>Forecasting & Strategy</strong>
                <p>Multi-source ontological synthesis, ArXiv ingestion, friction damping models.</p>
              </div>
              <div class="vsm-col">
                <span class="vsm-badge">System 5</span>
                <strong>Policy & Identity</strong>
                <p>Metasystemic constitution: Zero friction, 100% non-tech accessibility, zero data leaks.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    initAuth,
    connectNewGoogleDrive,
    disconnectAccount,
    disconnectAll,
    getAllAccounts,
    getActiveAccount,
    setActiveAccount,
    subscribeAccounts,
    type ConnectedDriveAccount
  } from "../lib/driveAuth";
  import { listDriveFiles, fetchFileContentPreview, type DriveFile } from "../lib/driveApi";
  import { mcpRegistry } from "../lib/mcpRegistry";

  let currentFiles: DriveFile[] = [];
  let selectedFile: DriveFile | null = null;
  let activeAccountsList: ConnectedDriveAccount[] = [];

  // DOM Elements
  const addDriveBtn = document.getElementById("add-google-drive-btn");
  const accountsChipList = document.getElementById("accounts-chip-list");
  const authStatusChip = document.getElementById("auth-status-chip");
  const driveAccountSelector = document.getElementById("drive-account-selector") as HTMLSelectElement;

  const driveLoading = document.getElementById("drive-loading-state");
  const driveEmptyUnauth = document.getElementById("drive-empty-unauth");
  const driveEmptySearch = document.getElementById("drive-empty-search");
  const driveFilesList = document.getElementById("drive-files-list");
  const filesCountBadge = document.getElementById("files-count-badge");
  const searchInput = document.getElementById("drive-search-input") as HTMLInputElement;
  const typeFilter = document.getElementById("drive-type-filter") as HTMLSelectElement;

  const tabModeler = document.getElementById("tab-modeler");
  const tabSimulator = document.getElementById("tab-simulator");
  const tabMcp = document.getElementById("tab-mcp");
  const tabPreview = document.getElementById("tab-preview");
  const tabFrictionless = document.getElementById("tab-frictionless");

  const viewModeler = document.getElementById("view-modeler");
  const viewSimulator = document.getElementById("view-simulator");
  const viewMcp = document.getElementById("view-mcp");
  const viewPreview = document.getElementById("view-preview");
  const viewFrictionless = document.getElementById("view-frictionless");
  const docPreviewContainer = document.getElementById("doc-preview-container");

  const metasystemLinkInput = document.getElementById("metasystem-link-input") as HTMLInputElement;
  const synthesizeBtn = document.getElementById("synthesize-btn");
  const synthesizerOutput = document.getElementById("synthesizer-output");
  const downloadManifestBtn = document.getElementById("download-full-manifest-btn");
  const mcpDriveResourcesCount = document.getElementById("mcp-drive-resources-count");

  const customMcpUrl = document.getElementById("custom-mcp-url") as HTMLInputElement;
  const addCustomMcpBtn = document.getElementById("add-custom-mcp-btn");
  const mcpConnectToast = document.getElementById("mcp-connect-toast");

  // Tab switching
  function switchTab(target: "modeler" | "simulator" | "mcp" | "preview" | "frictionless") {
    [tabModeler, tabSimulator, tabMcp, tabPreview, tabFrictionless].forEach((btn) => btn?.classList.remove("active"));
    [viewModeler, viewSimulator, viewMcp, viewPreview, viewFrictionless].forEach((el) => {
      if (el) el.style.display = "none";
    });

    if (target === "modeler") {
      tabModeler?.classList.add("active");
      if (viewModeler) viewModeler.style.display = "block";
    } else if (target === "simulator") {
      tabSimulator?.classList.add("active");
      if (viewSimulator) {
        viewSimulator.style.display = "block";
        resizeCanvases();
      }
    } else if (target === "mcp") {
      tabMcp?.classList.add("active");
