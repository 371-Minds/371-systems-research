    newBlueprint.querySelector(".export-bundle-btn")?.addEventListener("click", () => {
      exportStandaloneBundle(inputVal);
    });

    synthesizerOutput.prepend(newBlueprint);
  });

  // Export 1-Click HTML Bundle
  function exportStandaloneBundle(title: string) {
    const htmlContent = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title} - Frictionless Metasystem</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; padding: 2rem; margin: 0; line-height: 1.5; }
    .card { background: #1e293b; border-radius: 12px; padding: 1.5rem; max-width: 680px; margin: 2rem auto; border: 1px solid rgba(99, 102, 241, 0.3); box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
    h1 { font-size: 1.5rem; margin-top: 0; color: #a5b4fc; }
    .badge { display: inline-block; background: #22c55e22; color: #86efac; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; margin-bottom: 1rem; }
    .step { background: #0f172a; padding: 1rem; border-radius: 8px; margin-bottom: 0.75rem; border-left: 4px solid #6366f1; }
    button { background: #6366f1; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 1rem; }
    button:hover { background: #4f46e5; }
  </style>
</head>
<body>
  <div class="card">
    <span class="badge">100% Non-Tech Frictionless Delivery</span>
    <h1>${title}</h1>
    <p>This application was compiled autonomously from the Metasystemic Research Hub. It contains no external dependencies and runs in any modern browser without installation.</p>
    <div class="step">
      <strong>Cybernetic Stability:</strong> Feedback loops calibrated to zero cognitive overload.
    </div>
    <div class="step">
      <strong>Direct Execution:</strong> Standalone package with zero configuration required.
    </div>
    <button onclick="alert('Metasystem active and coherent!')">Execute Interactive Application</button>
  </div>
</body>
</html>`;

    const blob = new Blob([htmlContent], { type: "text/html" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `frictionless-${title.toLowerCase().replace(/[^a-z0-9]/g, "-")}.html`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Download JSON deployment manifest
  downloadManifestBtn?.addEventListener("click", () => {
    const manifest = {
      applet: "Systems Scientist Research Hub",
      version: "2.4.0",
      architecture: "Metasystemic Cybernetic Framework",
      deploymentTarget: "Zero-Friction Web & Electrobun Desktop",
      security: {
        oauthType: "1P Client-Side Ephemeral In-Memory",
        scopes: ["https://www.googleapis.com/auth/drive.readonly"]
      },
      loops: [
        { id: "B1", type: "Balancing", target: "Zero Cognitive Friction" },
        { id: "R1", type: "Reinforcing", target: "Knowledge Aggregation & Synergy" }
      ],
      timestamp: new Date().toISOString()
    };
    const blob = new Blob([JSON.stringify(manifest, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "metasystem-deploy.json";
    a.click();
    URL.revokeObjectURL(url);
  });

  // Search and Filter Events
  let debounceTimeout: any;
  searchInput?.addEventListener("input", () => {
    clearTimeout(debounceTimeout);
    debounceTimeout = setTimeout(() => {
      loadDriveData();
    }, 350);
  });

  typeFilter?.addEventListener("change", () => {
    loadDriveData();
  });

  refreshBtn?.addEventListener("click", () => {
    loadDriveData();
  });

  // Auth Listeners
  initAuth(
    (user) => {
      if (unauthView) unauthView.style.display = "none";
      if (authView) authView.style.display = "flex";
      if (userAvatar) userAvatar.src = user.photoURL || "https://api.dicebear.com/7.x/identicon/svg?seed=SystemsScientist";
      if (userName) userName.textContent = user.displayName || "Systems Scientist";
      if (userEmail) userEmail.textContent = user.email || "";
      if (authStatusChip) {
        authStatusChip.textContent = "Drive Connected (Read-Only)";
        authStatusChip.className = "hub-chip status-connected";
      }
      loadDriveData();
    },
    () => {
      if (unauthView) unauthView.style.display = "flex";
      if (authView) authView.style.display = "none";
      if (authStatusChip) {
        authStatusChip.textContent = "Drive Standby";
        authStatusChip.className = "hub-chip status-idle";
      }
      if (driveEmptyUnauth) driveEmptyUnauth.style.display = "flex";
      if (driveFilesList) driveFilesList.style.display = "none";
      if (filesCountBadge) filesCountBadge.textContent = "0 items";
    }
  );

  signinBtn?.addEventListener("click", async () => {
    try {
      signinBtn.setAttribute("disabled", "true");
      await googleSignIn();
      if (unauthView) unauthView.style.display = "none";
      if (authView) authView.style.display = "flex";
      loadDriveData();
    } catch (e: any) {
      alert(`Sign in was not completed: ${e.message}`);
    } finally {
      signinBtn.removeAttribute("disabled");
    }
  });

  signoutBtn?.addEventListener("click", async () => {
    await logout();
  });

  /* =========================================================
     CAUSAL LOOP VISUALIZER & DYNAMIC SIMULATOR
  ========================================================== */
  const causalCanvas = document.getElementById("causal-loop-canvas") as HTMLCanvasElement;
  const metricsCanvas = document.getElementById("metrics-plot-canvas") as HTMLCanvasElement;
  const simPlayPauseBtn = document.getElementById("sim-play-pause-btn");
  const simResetBtn = document.getElementById("sim-reset-btn");
  const simStepCounter = document.getElementById("sim-step-counter");

  const sliderAbstraction = document.getElementById("slider-abstraction") as HTMLInputElement;
  const sliderVelocity = document.getElementById("slider-velocity") as HTMLInputElement;
  const sliderFriction = document.getElementById("slider-friction") as HTMLInputElement;

  const valAbstraction = document.getElementById("val-abstraction");
  const valVelocity = document.getElementById("val-velocity");
  const valFriction = document.getElementById("val-friction");

  sliderAbstraction?.addEventListener("input", () => {
    if (valAbstraction) valAbstraction.textContent = `${sliderAbstraction.value}%`;
  });
  sliderVelocity?.addEventListener("input", () => {
    if (valVelocity) valVelocity.textContent = `${sliderVelocity.value}x`;
  });
  sliderFriction?.addEventListener("input", () => {
    if (valFriction) valFriction.textContent = `${sliderFriction.value}%`;
  });

  interface CausalNode {
    id: string;
    label: string;
    x: number;
    y: number;
    radius: number;
    color: string;
  }

  interface CausalEdge {
    from: string;
    to: string;
    polarity: "+" | "-";
    label: string;
  }

  const nodes: CausalNode[] = [
    { id: "ingestion", label: "Research Ingestion", x: 90, y: 70, radius: 36, color: "#6366f1" },
    { id: "ontology", label: "Ontological Model", x: 280, y: 55, radius: 34, color: "#a855f7" },
    { id: "abstraction", label: "Zero-Friction UI", x: 470, y: 75, radius: 36, color: "#06b6d4" },
    { id: "adoption", label: "Non-Tech Adoption", x: 460, y: 200, radius: 38, color: "#22c55e" },
    { id: "friction", label: "Cognitive Load", x: 280, y: 195, radius: 34, color: "#ef4444" },
    { id: "feedback", label: "Systemic Telemetry", x: 90, y: 200, radius: 34, color: "#f59e0b" },
  ];

  const edges: CausalEdge[] = [
    { from: "ingestion", to: "ontology", polarity: "+", label: "Structures" },
    { from: "ontology", to: "abstraction", polarity: "+", label: "Informs" },
    { from: "abstraction", to: "friction", polarity: "-", label: "Damps" },
    { from: "friction", to: "adoption", polarity: "-", label: "Inhibits" },
    { from: "abstraction", to: "adoption", polarity: "+", label: "Accelerates" },
    { from: "adoption", to: "feedback", polarity: "+", label: "Generates" },
    { from: "feedback", to: "ingestion", polarity: "+", label: "Reinforces (R1)" },
  ];

  interface Particle {
    fromNode: CausalNode;
    toNode: CausalNode;
    progress: number;
    speed: number;
  }

  let particles: Particle[] = [];
  let isSimulating = true;
  let simTime = 0;

  interface HistoryPoint {
    time: number;
    adoption: number;
    coherence: number;
    friction: number;
  }

  let simHistory: HistoryPoint[] = [];

  function resizeCanvases() {
    if (!causalCanvas || !metricsCanvas) return;
    const parentWidth = causalCanvas.parentElement?.clientWidth || 600;
    causalCanvas.width = Math.max(parentWidth, 320);
    causalCanvas.height = 270;
    metricsCanvas.width = Math.max(parentWidth, 320);
    metricsCanvas.height = 110;

    // Rescale node coordinates relative to width
    const w = causalCanvas.width;
    nodes[0]!.x = w * 0.16;
    nodes[0]!.y = 70;
    nodes[1]!.x = w * 0.50;
    nodes[1]!.y = 55;
    nodes[2]!.x = w * 0.84;
    nodes[2]!.y = 70;
    nodes[3]!.x = w * 0.84;
    nodes[3]!.y = 205;
    nodes[4]!.x = w * 0.50;
    nodes[4]!.y = 200;
    nodes[5]!.x = w * 0.16;
    nodes[5]!.y = 205;
  }

  window.addEventListener("resize", resizeCanvases);

  function spawnParticles() {
    if (particles.length > 20) return;
    edges.forEach((edge) => {
      if (Math.random() < 0.25) {
        const fromNode = nodes.find((n) => n.id === edge.from);
        const toNode = nodes.find((n) => n.id === edge.to);
        if (fromNode && toNode) {
          particles.push({
            fromNode,
            toNode,
            progress: 0,
            speed: 0.012 * (parseFloat(sliderVelocity?.value || "1.4")),
          });
        }
      }
    });
  }

  function drawCausalDiagram(ctx: CanvasRenderingContext2D) {
    ctx.clearRect(0, 0, causalCanvas.width, causalCanvas.height);

    // Draw Edges
    edges.forEach((edge) => {
      const fromNode = nodes.find((n) => n.id === edge.from);
      const toNode = nodes.find((n) => n.id === edge.to);
      if (!fromNode || !toNode) return;

      ctx.beginPath();
      ctx.moveTo(fromNode.x, fromNode.y);
      ctx.lineTo(toNode.x, toNode.y);
      ctx.strokeStyle = edge.polarity === "+" ? "rgba(34, 197, 94, 0.45)" : "rgba(56, 189, 248, 0.45)";
      ctx.lineWidth = 2;
      ctx.stroke();

      // Polarity symbol
      const midX = (fromNode.x + toNode.x) / 2;
      const midY = (fromNode.y + toNode.y) / 2;
      ctx.fillStyle = edge.polarity === "+" ? "#4ade80" : "#38bdf8";
      ctx.font = "bold 13px sans-serif";
      ctx.fillText(`(${edge.polarity})`, midX - 6, midY - 6);
    });

    // Draw Particles
    particles.forEach((p, idx) => {
      p.progress += p.speed;
      const curX = p.fromNode.x + (p.toNode.x - p.fromNode.x) * p.progress;
      const curY = p.fromNode.y + (p.toNode.y - p.fromNode.y) * p.progress;

      ctx.beginPath();
      ctx.arc(curX, curY, 4, 0, Math.PI * 2);
      ctx.fillStyle = "#fbbf24";
      ctx.shadowColor = "#fbbf24";
      ctx.shadowBlur = 8;
      ctx.fill();
      ctx.shadowBlur = 0;

      if (p.progress >= 1) {
        particles.splice(idx, 1);
      }
    });

    // Draw Nodes
    nodes.forEach((node) => {
      // Glow circle
      ctx.beginPath();
      ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(15, 23, 42, 0.9)";
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = node.color;
      ctx.stroke();

      // Text label
      ctx.fillStyle = "#f8fafc";
      ctx.font = "bold 10px sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      const words = node.label.split(" ");
      if (words.length === 2) {
        ctx.fillText(words[0]!, node.x, node.y - 6);
        ctx.fillText(words[1]!, node.x, node.y + 7);
      } else {
        ctx.fillText(node.label, node.x, node.y);
      }
    });
  }

  function stepSimulation() {
    simTime += 0.1;
    const abstraction = parseFloat(sliderAbstraction?.value || "85") / 100;
    const velocity = parseFloat(sliderVelocity?.value || "1.4");
    const frictionFactor = parseFloat(sliderFriction?.value || "70") / 100;

    // Cybernetic Euler integration step
    const friction = Math.max(5, 100 * (1 - abstraction) * (1 - frictionFactor * 0.5) + Math.sin(simTime * 0.4) * 3);
    const adoption = Math.min(99, 30 + (70 * abstraction) * (1 - Math.exp(-simTime * 0.1 * velocity)) - (friction * 0.15));
    const coherence = Math.min(98, 50 + 45 * (1 - Math.exp(-simTime * 0.08 * velocity)) + Math.cos(simTime * 0.2) * 2);

    simHistory.push({
      time: Math.round(simTime),
      adoption,
      coherence,
      friction,
    });

    if (simHistory.length > 50) {
      simHistory.shift();
    }

    if (simStepCounter) {
      simStepCounter.textContent = `T = ${Math.round(simTime)}s | Adoption: ${Math.round(adoption)}%`;
    }
  }

  function drawMetricsChart(ctx: CanvasRenderingContext2D) {
    ctx.clearRect(0, 0, metricsCanvas.width, metricsCanvas.height);
    const w = metricsCanvas.width;
    const h = metricsCanvas.height;

    // Background grid lines
    ctx.strokeStyle = "rgba(148, 163, 184, 0.1)";
    ctx.lineWidth = 1;
    for (let y = 20; y < h; y += 30) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    if (simHistory.length < 2) return;

    // Helper to plot series
    const plotSeries = (prop: "adoption" | "coherence" | "friction", color: string) => {
      ctx.beginPath();
      simHistory.forEach((pt, i) => {
        const x = (i / (simHistory.length - 1)) * w;
        const y = h - (pt[prop] / 100) * (h - 15) - 6;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.stroke();
    };

    plotSeries("adoption", "#22c55e");
    plotSeries("coherence", "#38bdf8");
    plotSeries("friction", "#ef4444");
  }

  function simLoop() {
    if (causalCanvas && metricsCanvas) {
      const causalCtx = causalCanvas.getContext("2d");
      const metricsCtx = metricsCanvas.getContext("2d");

      if (causalCtx) {
        if (isSimulating) spawnParticles();
        drawCausalDiagram(causalCtx);
      }

      if (metricsCtx && isSimulating) {
        stepSimulation();
        drawMetricsChart(metricsCtx);
      }
    }

    requestAnimationFrame(simLoop);
  }

  simPlayPauseBtn?.addEventListener("click", () => {
    isSimulating = !isSimulating;
    if (simPlayPauseBtn) {
      simPlayPauseBtn.textContent = isSimulating ? "⏸ Pause Simulation" : "▶ Resume Simulation";
    }
  });

  simResetBtn?.addEventListener("click", () => {
    simTime = 0;
    simHistory = [];
    particles = [];
    if (metricsCanvas) {
      const metricsCtx = metricsCanvas.getContext("2d");
      if (metricsCtx) metricsCtx.clearRect(0, 0, metricsCanvas.width, metricsCanvas.height);
    }
  });

  // Start animation loop
  resizeCanvases();
  requestAnimationFrame(simLoop);
</script>

