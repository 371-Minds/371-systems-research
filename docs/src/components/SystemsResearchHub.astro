        </div>
        <div class="bp-step">
          <div class="step-num">📦</div>
          <div>
            <strong>Universal Deployment Target:</strong>
            Lightweight packaged client ready for immediate browser viewing or desktop single-click launch.
          </div>
        </div>
      </div>
      <div class="bp-actions">
        <button class="hub-btn hub-btn-sm hub-btn-outline export-bundle-btn" type="button">
          📦 Export 1-Click HTML Bundle
        </button>
