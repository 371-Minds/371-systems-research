{
  "name": "electrobun-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "lint": "astro check",
    "test": "bun test ./scripts/project-boundary.test.mjs",
    "check": "bun run lint && bun run test && bun run check:examples",
    "check:examples": "bun scripts/check-code-examples.mjs",
    "deploy": "wrangler pages deploy dist --project-name=framework-docs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.30.0",
    "astro": "^5.15.4",
    "firebase": "^12.19.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/bun": "^1.4.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.10",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "wrangler": "^4.0.0",
    "yaml": "^2.8.3"
  }
}
