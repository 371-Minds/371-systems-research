{
  "name": "electrobun-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --cwd docs dev",
    "build": "bun run --cwd docs build",
    "lint": "bun run --cwd docs lint",
    "preview": "bun run --cwd docs preview",
    "test": "bun run --cwd docs test",
    "check": "bun run lint && bun run test && bun run --cwd docs check:examples"
  },
  "workspaces": [
    "docs"
  ],
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
